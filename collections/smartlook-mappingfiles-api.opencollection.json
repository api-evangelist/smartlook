              },
              {
                "name": "platform",
                "value": "",
                "type": "path"
              },
              {
                "name": "appVersion",
                "value": "",
                "type": "path"
              },
              {
                "name": "force",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Upload mapping files for crash reports"
        }
      ]
    }
  ],
  "bundled": true
}